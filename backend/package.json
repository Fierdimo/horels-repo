{
  "name": "sw2-backend",
  "version": "1.0.0",
  "description": "Backend for SW2 hospitality swap/conversion platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "test": "npm run test:sequential && npm run test:e2e",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "vitest watch --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.unit.config.ts",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "test:ui": "vitest --ui",
    "test:sequential": "bash -lc 'mkdir -p tmp && ./scripts/run_tests_sequential.sh 2>&1 | tee tmp/sequential_test_results.txt; exit ${PIPESTATUS[0]}'",
    "test:sequential:manual": "bash ./scripts/manual_sequential.sh",
    "test:credits": "vitest run tests/integration/credits/*.test.ts tests/e2e/creditSystem.e2e.test.ts",
    "test:credits:watch": "vitest watch tests/integration/credits/*.test.ts",
    "test:credits:e2e": "vitest run tests/e2e/creditSystem.e2e.test.ts",
    "test:credits:coverage": "vitest run --coverage tests/integration/credits/*.test.ts tests/e2e/creditSystem.e2e.test.ts",
    "migrate": "sequelize-cli db:migrate",
    "migrate:v2": "sequelize-cli db:migrate --config config/config.json --migrations-path migrations_v2",
    "migrate:undo:v2": "sequelize-cli db:migrate:undo --config config/config.json --migrations-path migrations_v2",
    "migrate:status:v2": "sequelize-cli db:migrate:status --config config/config.json --migrations-path migrations_v2",
    "db:reset:v2": "ts-node scripts/reset-db-v2.ts",
    "db:create-admin": "ts-node scripts/create-admin-user.ts",
    "document:schema": "node scripts/document-v2-schema.js",
    "seed": "sequelize-cli db:seed:all",
    "seed:v2": "ts-node scripts/seed-v2.ts",
    "seed:mock-pms": "ts-node src/scripts/seed-from-mock-pms.ts",
    "start:worker": "ts-node src/bin/start-worker.ts",
    "worker:sync": "ts-node src/bin/worker-sync.ts",
    "check:mews": "ts-node src/scripts/check_mews_connection.ts",
    "clean-resync": "ts-node scripts/clean-and-resync.ts"
  },
  "dependencies": {
    "@types/json2csv": "^5.0.7",
    "@types/multer": "^2.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.4",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.65.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "mailgun.js": "^12.4.0",
    "mariadb": "^3.4.5",
    "multer": "^2.0.2",
    "mysql2": "^3.6.5",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "sequelize": "^6.35.0",
    "stripe": "^20.0.0"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/sequelize": "^4.28.20",
    "@types/supertest": "^6.0.3",
    "@vitest/ui": "^4.0.14",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "author": "",
  "license": "ISC"
}
